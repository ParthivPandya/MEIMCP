# ==============================================================================
# Microsoft Engineering Intelligence MCP — Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your values.
# All secrets should be stored in Azure Key Vault in production.
# ==============================================================================

# ──────────────────────────────────────────────────────────────────────────────
# Server
# ──────────────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
LOG_LEVEL=debug

# ──────────────────────────────────────────────────────────────────────────────
# Microsoft Entra ID (Azure AD)
# ──────────────────────────────────────────────────────────────────────────────
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret

# Set to "true" to bypass Entra auth in development (uses mock user context)
AUTH_BYPASS_ENABLED=true

# ──────────────────────────────────────────────────────────────────────────────
# Azure DevOps
# ──────────────────────────────────────────────────────────────────────────────
ADO_ORGANIZATION=your-organization
ADO_PAT=your-personal-access-token

# Comma-separated list of allowed project names (empty = allow all configured)
ADO_ALLOWED_PROJECTS=

# ──────────────────────────────────────────────────────────────────────────────
# Azure Monitor / Log Analytics
# ──────────────────────────────────────────────────────────────────────────────
AZURE_LOG_ANALYTICS_WORKSPACE_ID=your-workspace-id
AZURE_SUBSCRIPTION_ID=your-subscription-id

# ──────────────────────────────────────────────────────────────────────────────
# Azure OpenAI
# ──────────────────────────────────────────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=https://your-instance.openai.azure.com
AZURE_OPENAI_API_KEY=your-api-key
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# ──────────────────────────────────────────────────────────────────────────────
# Azure AI Search (RAG)
# ──────────────────────────────────────────────────────────────────────────────
AZURE_AI_SEARCH_ENDPOINT=https://your-instance.search.windows.net
AZURE_AI_SEARCH_API_KEY=your-api-key
AZURE_AI_SEARCH_INDEX_NAME=engineering-knowledge

# ──────────────────────────────────────────────────────────────────────────────
# Observability
# ──────────────────────────────────────────────────────────────────────────────
APPLICATIONINSIGHTS_CONNECTION_STRING=
OTEL_EXPORTER_OTLP_ENDPOINT=

# ──────────────────────────────────────────────────────────────────────────────
# Policy
# ──────────────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed tenant IDs (empty = allow any validated tenant)
ALLOWED_TENANT_IDS=

# Tool permission defaults: enabled | confirmation | disabled
POLICY_MUTATE_DEFAULT=disabled
POLICY_WRITE_DEFAULT=confirmation
